  "max_depth": 8,
  "max_trees": 300,
  "primary_budget": 9,
  "primary_accuracy_rule": "1se",
  "python": "3.12.3",
  "numpy": "2.5.4",
  "pandas": "3.0.6",
  "scikit_learn": "1.9.1",
  "scipy": "1.18.1"
}